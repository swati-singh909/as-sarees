# The site already reads the A.S. Sarees Google Sheet by its ID, so you
# normally need nothing here. Copy this file to `.env` only to change that.
# The same keys go into Cloudflare Pages → Settings → Environment variables.

# ID of the Google Sheet (the long part of its link, between /d/ and /edit).
VITE_SHEET_ID=1kekePlcqmymoZdaXF8ajZm99yNO_Bx5FDVh2VzR_6sE

# Optional: if you prefer "File → Share → Publish to web" links, paste the
# CSV link of each tab here. When set, these are used instead of the ID.
# VITE_SAREES_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv
# VITE_FABRICS_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=111&single=true&output=csv
# VITE_SETTINGS_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=222&single=true&output=csv
